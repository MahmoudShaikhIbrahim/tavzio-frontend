# Staging environment template. Copy this to .env in the STAGING worktree
# folder only (e.g. tavzio-frontend-staging/.env) and fill in real staging
# values. This file itself never holds real secrets.

# Your staging backend's Railway URL, once that environment exists, e.g.
# https://tavzio-backend-staging.up.railway.app
# Leave blank for pure local dev (Vite's proxy forwards /api to
# http://localhost:5000, i.e. your local backend, which should itself be
# pointed at staging Supabase via ITS .env - see the backend repo's
# .env.staging.example).
VITE_API_BASE_URL=

# The STAGING Supabase project - same URL/anon key as the backend's
# .env.staging.example uses, not the production ones.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fine to reuse the real Turnstile site key here too - it's public by
# design and not a customer-data or payment risk either way.
VITE_TURNSTILE_SITE_KEY=
