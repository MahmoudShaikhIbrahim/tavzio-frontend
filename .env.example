# Leave blank for local dev - Vite's proxy (vite.config.ts) forwards /api
# to http://localhost:5000 automatically.
# Set this once the backend is deployed on Railway, e.g.:
# VITE_API_BASE_URL=https://tavzio-backend-production.up.railway.app
VITE_API_BASE_URL=

# Needed for two things the frontend talks to Supabase directly for (not
# through the backend): live dashboard updates (Realtime) and uploading
# logo/cover images (Storage). Same values as the backend's SUPABASE_URL /
# SUPABASE_ANON_KEY - the anon key is meant to be public, safe to expose here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key - public by design (this is what loads
# the actual bot-check widget in the browser). Get it from the Cloudflare
# dashboard: Turnstile > Add site > Widget mode "Managed" is the
# recommended default (invisible-first, escalates to a visible puzzle
# only when needed). The login page still works with this unset - the
# widget just doesn't render, and the backend's own check (which fails
# open when its matching secret is also unset) doesn't block anyone.
VITE_TURNSTILE_SITE_KEY=
